{
    "name": "jt4d-source",
    "$schema": "./node_modules/nx/schemas/project-schema.json",
    "targets": {
        "lint": {
            "executor": "@nx/eslint:lint",
            "options": {
                "lintFilePatterns": [
                    "tools/**/*.{ts,mjs}",
                    "*.{ts,mjs}"
                ],
                "fix": true
            }
        },
        "lint-check": {
            "executor": "@nx/eslint:lint",
            "options": {
                "lintFilePatterns": [
                    "tools/**/*.{ts,mjs}",
                    "*.{ts,mjs}"
                ]
            }
        },
        "format": {
            "executor": "nx:run-commands",
            "options": {
                "command": "prettier --write . \"!apps/**\" \"!packages/**\""
            }
        },
        "format-check": {
            "executor": "nx:run-commands",
            "options": {
                "command": "prettier --check . \"!apps/**\" \"!packages/**\""
            }
        }
    }
}
