{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "emitDeclarationOnly": false,
        "declarationMap": false,
        "outDir": "dist",
        "rootDir": "src",
        "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
        "types": [
            "node"
        ]
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "eslint.config.mjs",
        "vitest.config.ts",
        "src/test-setup.ts",
        "src/**/*.spec.ts",
        "src/**/*.test.ts"
    ],
    "references": [
        {
            "path": "../../packages/common/tsconfig.lib.json"
        }
    ]
}
